#!/bin/sh
# Ce que la DoD demande de vérifiable par une commande (DOD.md §1).
#
# Échoue au premier manquement, et dit lequel. Volontairement bête : ce script
# doit pouvoir être lu en entier avant d'être exécuté.
set -eu

echo "→ gofmt"
mal_formates=$(gofmt -l .)
if [ -n "$mal_formates" ]; then
	echo "fichiers mal formatés :" >&2
	echo "$mal_formates" >&2
	echo "  corriger avec : gofmt -w ." >&2
	exit 1
fi

# Les entrées de journal en attente : un fichier par tâche sous changelog.d/
# (DOD.md §1). Qu'une tâche ait bien déposé la sienne ne se vérifie pas par une
# commande — ça se lit à la review. Ce qui se vérifie, c'est que ce qui est
# déposé sera utilisable le jour de la publication. Placé tôt : il coûte une
# milliseconde, il doit rougir avant les deux minutes de tests.
echo "→ journal"
for fragment in changelog.d/*.md; do
	case "$fragment" in
	changelog.d/LISEZ-MOI.md) continue ;;
	changelog.d/\*.md) continue ;;  # répertoire vide : le glob n'a rien trouvé
	esac
	if [ ! -s "$fragment" ]; then
		echo "fragment vide : $fragment" >&2
		exit 1
	fi
	# Le fichier est recopié tel quel dans le journal : il doit donc commencer
	# par une puce, sans quoi la section publiée serait mal formée.
	if ! head -1 "$fragment" | grep -q '^- '; then
		echo "fragment qui ne commence pas par une puce « - » : $fragment" >&2
		echo "  son contenu est recopié tel quel dans CHANGELOG.md" >&2
		exit 1
	fi
done

echo "→ go vet"
go vet ./...

# Deux passes, un seul script : AVEC_RACE=1 ajoute le détecteur de courses.
# Un second script, ce seraient deux définitions du vert dont une seule reste à
# jour — c'est exactement ce que l'en-tête de .github/workflows/verifie.yml
# refuse. La CI lance la passe longue, elle seule : elle contient la courte.
#
# Le -timeout n'est posé que là. Le détecteur multiplie la durée par dix là où
# un paquet monte une base PocketBase, et le paquet cmd/patachoo en monte une
# par test : le défaut de go test, dix minutes par paquet, est dépassé. Un rouge
# doit parler d'une course, pas d'un délai. Jamais -timeout=0 en revanche : un
# test bloqué doit finir par rendre la main et sa pile.
#
# Trois heures, et non plus une. Ce plafond se dimensionne sur la durée réelle
# de cmd/patachoo, qui grandit avec le nombre de ses tests, et la marge doit
# couvrir la charge de la machine autant que le nombre de tests : le runner est
# auto-hébergé, et les cycles d'agents lancent leur propre ./verifie pendant
# qu'un job tourne. Relevé le 22/09/2026, à 689 tests :
#   - machine peu chargée : ~3,9 s par test, soit ~45 min pour le paquet ;
#   - en concurrence avec un job de CI : ~8,5 s par test, soit ~100 min.
# Une heure tombait donc au milieu de cette plage — c'est ce qui a fait rougir
# la CI sur un délai, avec des tests encore en attente et la passe jamais
# terminée : une course dans les tests non joués serait passée inaperçue. La
# durée du paquet reste le vrai sujet, et il a sa tâche (PATA-129) ; ce plafond
# n'est pas l'endroit où l'on borne un temps d'exécution, seulement celui où
# l'on garantit qu'un rouge parle d'une course.
if [ "${AVEC_RACE:-}" = "1" ]; then
	echo "→ go test -race"
	go test -race -timeout=180m ./...
else
	echo "→ go test"
	go test ./...
fi

# La version est figée, et c'est délibéré : une version flottante laissait le
# proxy de modules décider, au moment où la commande tourne, de quel code
# s'exécute ici — c'était la dernière publiée, quelle qu'elle soit.
# Ici, c'est-à-dire sur la machine de développement, sous l'identité de
# l'hébergeant, dans un répertoire de travail qui porte des jetons — à chaque
# geste, puisque ce script se lance à chaque geste. Épingler ferme ce que le
# journal de transparence ne couvre pas : il garantit qu'une version publiée
# n'est pas réécrite, pas qu'une version nouvelle est honnête.
#
# Le contrepoids habituel de l'épinglage — « on cesse d'être à jour » — ne joue
# pas ici : la base de vulnérabilités est interrogée sur vuln.go.dev à
# l'exécution, indépendamment de la version de l'outil. Une faille publiée
# demain est donc vue demain par ce binaire figé aujourd'hui. Ce qui est figé,
# c'est le moteur d'analyse d'atteignabilité.
#
# Le dépôt n'a ni Dependabot ni automate de montée de version (tranché en
# PATA-91) : la remonter est un geste manuel, à faire quand on le décide.
#   go list -m -versions golang.org/x/vuln   # les versions publiées
# puis changer le numéro ci-dessous. L'empreinte de ce qui est téléchargé vient
# du journal de transparence (sum.golang.org), pas de go.sum : le module est
# volontairement hors de go.mod, pour ne pas mêler l'outillage aux dépendances
# du produit.
echo "→ govulncheck"
if [ "${SANS_RESEAU:-}" = "1" ]; then
	echo "  sauté (SANS_RESEAU=1) — à repasser avant de clore la tâche"
else
	go run golang.org/x/vuln/cmd/govulncheck@v1.8.0 ./...
fi

echo "✓ tout est vert"
